:root {
    --panel: rgba(30, 35, 41, 0.88);
    --panel-solid: rgb(30, 35, 41);
    --panel-raised: rgba(48, 55, 63, 0.95);
    --text: rgb(243, 241, 236);
    --muted: rgb(138, 144, 153);
    --accent: rgb(255, 181, 71);
    --danger: rgb(229, 72, 77);
    --line: rgba(243, 241, 236, 0.12);
    --radius: 14px;
    color: var(--text);
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Barlow-SemiBold SDF.asset");
}

.root {
    flex-grow: 1;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--panel);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--line);
    padding: 12px 16px;
}

/* ───────────── HUD ───────────── */

.top-bar {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.week-card {
    flex-direction: row;
    align-items: center;
}

.week-block {
    margin-right: 18px;
}

.caption {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--muted);
    -unity-font-style: bold;
}

.big-number {
    font-size: 40px;
    -unity-font-style: bold;
    margin-top: -4px;
}

.days {
    width: 210px;
    margin-right: 16px;
}

.day-labels {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.day-label {
    font-size: 12px;
    color: var(--muted);
}

.day-label.today {
    color: var(--accent);
    -unity-font-style: bold;
}

.progress-track {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(243, 241, 236, 0.12);
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    border-radius: 4px;
    background-color: var(--accent);
}

.speed-group {
    flex-direction: row;
}

.icon-button {
    width: 40px;
    height: 40px;
    margin-left: 6px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(243, 241, 236, 0.08);
    padding: 9px;
    color: var(--text);
    transition-duration: 0.12s;
}

.icon-button:hover {
    background-color: rgba(243, 241, 236, 0.18);
}

.icon-button.selected {
    background-color: var(--accent);
    color: var(--panel-solid);
}

.score-card {
    flex-direction: row;
    align-items: center;
}

.score-icon {
    width: 34px;
    height: 34px;
    margin-right: 12px;
    color: var(--accent);
}

.cargo-legend {
    flex-direction: row;
    margin-top: 10px;
    justify-content: flex-end;
}

.cargo-chip {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
}

.cargo-swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    margin-right: 6px;
}

.cargo-name {
    font-size: 13px;
}

.right-column {
    align-items: flex-end;
}

.toolbar {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.toolbar-panel {
    flex-direction: row;
    padding: 10px;
}

.tool-button {
    width: 96px;
    height: 86px;
    margin: 0 4px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(243, 241, 236, 0.06);
    padding: 8px 6px 6px 6px;
    align-items: center;
    color: var(--text);
    transition-duration: 0.12s;
}

.tool-button:hover {
    background-color: rgba(243, 241, 236, 0.14);
}

.tool-button.selected {
    border-color: var(--accent);
    background-color: rgba(255, 181, 71, 0.14);
}

.tool-button.empty {
    color: var(--muted);
}

.tool-icon {
    width: 34px;
    height: 34px;
}

.tool-name {
    font-size: 13px;
    margin-top: 4px;
}

.tool-count {
    position: absolute;
    top: 4px;
    right: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--accent);
}

.tool-button.empty > .tool-count {
    color: var(--danger);
}

.tool-key {
    position: absolute;
    top: 5px;
    left: 8px;
    font-size: 11px;
    color: var(--muted);
}

.hint {
    position: absolute;
    left: 24px;
    bottom: 26px;
    font-size: 13px;
    color: var(--muted);
    background-color: var(--panel);
    border-radius: 10px;
    padding: 8px 12px;
}

.toast {
    position: absolute;
    top: 110px;
    left: 0;
    right: 0;
    align-items: center;
}

.toast-label {
    background-color: var(--panel);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--accent);
    padding: 10px 18px;
    font-size: 17px;
    opacity: 0;
    translate: 0 -8px;
    transition-duration: 0.25s;
}

.toast-label.shown {
    opacity: 1;
    translate: 0 0;
}

.toast-label.danger {
    border-color: var(--danger);
}

/* ───────────── Overlays ───────────── */

.dim {
    background-color: rgba(18, 20, 24, 0.55);
    align-items: center;
    justify-content: center;
}

.modal {
    background-color: var(--panel);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--line);
    padding: 28px 32px;
    align-items: center;
    min-width: 460px;
}

.modal-title {
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.modal-sub {
    font-size: 17px;
    color: var(--muted);
    margin-top: 6px;
    margin-bottom: 22px;
    -unity-text-align: middle-center;
}

.cards {
    flex-direction: row;
}

.card {
    width: 250px;
    height: 250px;
    margin: 0 10px;
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--line);
    background-color: var(--panel-raised);
    padding: 22px 18px;
    align-items: center;
    justify-content: center;
    color: var(--text);
    transition-duration: 0.15s;
}

.card:hover {
    border-color: var(--accent);
    scale: 1.04 1.04;
}

.card-icon {
    width: 72px;
    height: 72px;
    margin-bottom: 14px;
    color: var(--accent);
}

.card-title {
    font-size: 24px;
    -unity-font-style: bold;
}

.card-desc {
    font-size: 15px;
    color: var(--muted);
    margin-top: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.button {
    min-width: 220px;
    height: 52px;
    margin-top: 10px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgba(243, 241, 236, 0.1);
    color: var(--text);
    font-size: 19px;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.button:hover {
    background-color: rgba(243, 241, 236, 0.2);
}

.button.primary {
    background-color: var(--accent);
    color: var(--panel-solid);
}

.button.primary:hover {
    background-color: rgb(255, 199, 115);
}

.slider-row {
    flex-direction: row;
    align-items: center;
    width: 360px;
    margin-bottom: 6px;
}

.slider-label {
    width: 90px;
    font-size: 16px;
}

.slider {
    flex-grow: 1;
}

.slider #unity-tracker {
    background-color: rgba(243, 241, 236, 0.15);
    border-width: 0;
    height: 6px;
    margin-top: -3px;
    border-radius: 3px;
}

.slider #unity-dragger {
    background-color: var(--accent);
    border-width: 0;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-radius: 9px;
}

/* ───────────── Main menu ───────────── */

.menu {
    justify-content: center;
    padding-left: 110px;
}

.menu-panel {
    background-color: var(--panel);
    border-radius: 22px;
    border-width: 1px;
    border-color: var(--line);
    padding: 40px 44px;
    width: 430px;
}

.title {
    font-size: 92px;
    -unity-font-style: bold;
    letter-spacing: 10px;
    color: var(--text);
}

.title-accent {
    height: 6px;
    width: 120px;
    background-color: var(--accent);
    border-radius: 3px;
    margin-bottom: 12px;
}

.subtitle {
    font-size: 21px;
    color: var(--muted);
    letter-spacing: 3px;
    margin-bottom: 28px;
}

.menu-panel > .button {
    width: 100%;
}

.menu-stat {
    margin-top: 18px;
    font-size: 15px;
    color: var(--muted);
}

.credits {
    position: absolute;
    right: 24px;
    bottom: 18px;
    font-size: 12px;
    color: rgba(243, 241, 236, 0.55);
}

.stat-row {
    flex-direction: row;
    margin-bottom: 18px;
}

.stat {
    align-items: center;
    margin: 0 22px;
}

.stat-value {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--accent);
}

.stat-name {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--muted);
}

.danger-title {
    color: var(--danger);
}

.icon-button > .glyph {
    flex-grow: 1;
}
